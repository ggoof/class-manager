# ---------------------------------------------------------------- Firestore
# The Firebase project the API reads and writes.
FIREBASE_PROJECT_ID="classroom-9042d"

# A service-account key, as raw JSON on one line or base64 (most hosting
# dashboards mangle multi-line values, so base64 is the safer paste):
#   Firebase console -> Project settings -> Service accounts -> Generate new private key
#   base64 -w0 serviceAccount.json          # Linux
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))   # PowerShell
# FIREBASE_SERVICE_ACCOUNT=""
#
# Alternatively point at the key file on disk and leave the above unset:
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
#
# Or run against the local emulator, where no credentials are needed at all:
#   firebase emulators:start --only firestore
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# ----------------------------------------------------------------- API server
# Sign key for session tokens. Generate a real one before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-insecure-secret-change-me"

PORT=3000

# The web origin allowed to call this API. In production that is your Firebase
# Hosting site, e.g. "https://classroom-9042d.web.app,https://classroom-9042d.firebaseapp.com"
CORS_ORIGIN="http://localhost:5173"
