# Baked into the bundle by `vite build`. Everything here ships to the browser,
# so put nothing secret in this file.

# The Render API origin — no trailing slash, no /api suffix.
VITE_API_BASE_URL="https://class-manager-api-orjv.onrender.com"

# Firebase web config for Analytics (public by design). Unset = Analytics off.
# Register a web app in the futuretelling-d14bf console and paste its config here
# to turn it on.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_MEASUREMENT_ID=""
